---
import Base from './Base.astro';
import { formatPostDate, type Post as PostEntry } from '../lib/posts';

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { title, date, author } = post.data;
---

<Base title={title}>
  <article class="post">
    <header class="post__header">
      <h1 class="post__title">{title}</h1>
      <p class="post__meta">
        <time datetime={date.toISOString()}>{formatPostDate(date)}</time>
        {author && <> • {author}</>}
      </p>
    </header>
    <div class="post__content">
      <slot />
    </div>
  </article>
</Base>
