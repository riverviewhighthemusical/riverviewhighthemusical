---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import PayPalButton from '../../components/PayPalButton.astro';

// Filenames are date-prefixed in display order.
const albums = (await getCollection('albums')).sort((a, b) => a.id.localeCompare(b.id));
---

<Base title="Soundtrack">
  <p>Soundtracks will be delivered by email (MP3s) within 1-2 business days.</p>

  {
    albums.map(({ data }) => (
      <div class="col-2up product">
        <div class="product__image">
          <Image src={data.image} alt={`${data.title} album cover`} width={400} />
        </div>
        <div class="product__info">
          <h2>{data.title}</h2>
          <span class="product__subtitle">featuring:</span>
          <ul>
            {data.songs.map(({ name }) => (
              <li class="product__item">
                <em>{name}</em>
              </li>
            ))}
          </ul>
          <p class="product__price">
            Price: <strong>${data.price}</strong>
          </p>
          <PayPalButton buttonId={data.paypal} />
        </div>
      </div>
    ))
  }

  <Callout icon="music" href="/sheet-music">Sheet music now available!</Callout>
</Base>
