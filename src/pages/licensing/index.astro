---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import { CONTACT_EMAIL, YOUTUBE_FULL_SHOW } from '../../consts';
import killarneyPoster from '../../assets/img/killarney-poster.jpg';
import milkshake from '../../assets/img/circle-milkshake.png';
import alexParker from '../../assets/img/alex-parker.jpg';
import jessieBunnygirls from '../../assets/img/jessie-bunnygirls.jpg';

const principals = [
  { name: 'ALEX', voice: 'baritenor', bio: 'is a red-headed teenager who often thinks less with his brain and more with his crotch. He is simultaneously in love with Cathy and Erica and has a tough time committing to just one girl.' },
  { name: 'CATHY C.', voice: 'mezzo', bio: 'is a sweet, loveable blonde who has been friends with Alex since grade school - and has been in love with Alex for just as long. Her rival is Erica.' },
  { name: 'ERICA SNODGE', voice: 'alto', bio: 'is brunette vixen from the richest family in Riverview. She always gets what she wants and what she wants is Alex. Her rival is Cathy.' },
  { name: 'PARKER', voice: 'baritone', bio: 'is the best friend of Alex. He is a food-lover and a lady-hater. He is the unwilling object of Esther\'s affection.' },
  { name: 'DEXTER', voice: 'tenor', bio: 'is the smartest student at Riverview High. He is shy and has low self-esteem due to his nerdy appearance. He is secretly in love with Cathy, who is clueless about his feelings.' },
  { name: 'RANDY', voice: 'tenor', bio: 'is a rich teenager with a sharp tongue and a deep sense of entitlement. He believes that Erica belongs with him, and openly despises Alex for coming between him and Erica.' },
  { name: 'ESTHER', voice: 'alto', bio: 'is an awkward girl who transferred to Riverview High in her freshman year – the same year she fell in love with Parker. She often tries to win over Parker with her antics, but with little success.' },
  { name: 'SCARLETT CHAMBERS', voice: 'alto', bio: 'is a rich and flirty red-head. She attends Oceanview High – the arch rival school of Riverview High. She loves to seduce guys and toy with their affections.' },
];

const ensemble = [
  { name: 'JASON SPANO', bio: 'is the Senior Class President at Riverview High.' },
  { name: 'JESSIE, MALLORY, and HARMONIE', bio: "form Riverview High's hottest pop group, Jessie and the Bunnygirls." },
  { name: 'CHAD, TAD, and BRAD', bio: 'are the rich jock friends of Randy and bully other students.' },
  { name: 'MINDY LAWFORD, FELICIA SILVERROCK, and KAT GLOSS', bio: 'are famous models who often grace the covers of magazines.' },
  { name: 'HALL MONITOR', bio: 'is the "enforcer" at Riverview High.' },
  { name: 'SODA JERK', bio: 'is the waiter at the Soda Fountain.' },
  { name: 'ROSA, SOPHIE and CAROL', bio: "are Erica's maids who are constantly at her beck and call." },
  { name: 'CHEERLEADERS', bio: 'of Riverview High. Their high-energy cheers always lift the spirit of the student body.' },
  { name: 'ARTIE', bio: 'is a cocky freshman who is entering his first year at Riverview High.' },
  { name: 'BETSY', bio: 'is the sweet blonde girlfriend of Artie.' },
  { name: 'VERONIKA', bio: 'is the sassy brunette girlfriend of Artie.' },
];
---

<Base title="Licensing">
  <Callout icon="music" href={`mailto:${CONTACT_EMAIL}`}>Request a perusal copy of the script!</Callout>

  <div class="col-sidebar">
    <div class="col-sidebar__sidebar">
      <Image src={killarneyPoster} alt="Killarney Secondary School production poster" width={280} />
    </div>
    <div class="col-sidebar__main">
      <p>
        Following an award-winning Fringe Festival run in 2012 and a remount in 2013, the creative team began licensing
        <em>Riverview High: The Musical (School Edition)</em>, which debuted at Killarney Secondary School in January
        2015.
      </p>
      <p><strong>Style</strong>: Fun, contemporary pop musical theatre.</p>
      <p>
        <strong>Themes</strong>: Romance, self-acceptance, diversity, being true to yourself, following your heart.
      </p>
      <p><strong>Cast Size</strong>: 8 principals, 8-22 ensemble. All teenage roles.</p>
      <p><strong>Orchestra</strong>: Keyboard, drums, bass, guitar.</p>
      <p><strong>Setting</strong>: Riverview High School, 1996.</p>
    </div>
  </div>

  <div class="col-sidebar">
    <div class="col-sidebar__main">
      <h2>Plot</h2>
      <p>
        It's the classic story of a love triangle: a sweet blonde, a sexy brunette, and an ever-so-confused redhead.
        Set in 1996, the musical begins with Alex accidentally asking both Cathy and Erica to prom.
      </p>
      <p>
        When the girls find out, they demand he choose which one he wants to embark on his future with -
        girl-next-door Cathy or sophisticated Erica?
      </p>
      <p><a class="button" href="/about">More about the show</a></p>
    </div>
    <div class="col-sidebar__sidebar">
      <Image src={milkshake} alt="Milkshake" width={270} />
    </div>
  </div>

  <div class="col-sidebar">
    <div class="col-sidebar__sidebar">
      <Image src={alexParker} alt="Alex and Parker" width={540} />
    </div>
    <div class="col-sidebar__main">
      <h2>Principals</h2>
      {
        principals.map(({ name, voice, bio }) => (
          <p>
            <strong>{name}</strong> <em>({voice})</em> {bio}
          </p>
        ))
      }
    </div>
  </div>

  <div class="col-sidebar">
    <div class="col-sidebar__main">
      <h2>Ensemble</h2>
      {
        ensemble.map(({ name, bio }) => (
          <p>
            <strong>{name}</strong> {bio}
          </p>
        ))
      }
    </div>
    <div class="col-sidebar__sidebar">
      <figure>
        <Image src={jessieBunnygirls} alt="Jessie and the Bunnygirls" width={535} />
        <figcaption>Jessie and the Bunnygirls</figcaption>
      </figure>
    </div>
  </div>

  <Callout icon="youtube" href={YOUTUBE_FULL_SHOW}>Watch the full musical on YouTube!</Callout>
</Base>
